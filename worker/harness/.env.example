# Copy to harness/.env and fill in. harness/.env is gitignored; this file is not.
#
# ROUTE 1 — DeepSeek direct (works today, no proxy)
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ROUTE 2 — any other model through an OpenAI-compatible proxy (e.g. LiteLLM).
# dsh's bundled adapter speaks DeepSeek's dialect, so a proxy is required for
# Anthropic/OpenAI/local models -- see docs/DSH-MIGRATION.md "Model routing".
#   litellm --model anthropic/claude-sonnet-4-20250514 --port 4000
# then point the adapter at it and put the PROXY's key here:
# DEEPSEEK_BASE_URL=http://localhost:4000/v1
# DEEPSEEK_API_KEY=sk-anything-the-proxy-accepts
#
# The upstream provider key the proxy itself uses (LiteLLM reads this directly):
# ANTHROPIC_API_KEY=

# ROUTE 3 — mock, for testing the composition with no credentials at all.
# Selected with `--route mock`; needs no keys.
