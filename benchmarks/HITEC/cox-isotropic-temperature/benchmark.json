  "id": "hitec-cox-isotropic-temperature",
  "title": "HITEC near-field benchmark - COx claystone, isotropic, heat conduction from gallery (10 y)",
  "source": {
   "authors": [
    "Simo",
    "de Lesquen",
    "Leon-Vargas",
