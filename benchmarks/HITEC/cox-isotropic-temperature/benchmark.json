    "_comment_rho": "PAPER_VALUE Tab. 1: saturated bulk density 2386 kg/m3",
    "_comment_cp": "INFERRED: mixture cp = [(1-n)*rho_s*cp_s + n*rho_w*cp_w]/rho_sat with n=0.18, rho_s=2690, cp_s=790 (Tab. 1), rho_w=1000, cp_w=4180 (Sec. 3) -> 1045.7 J/(kg.K)"
   }
  }
 },
 "initial_conditions": [
  {
   "field": "temperature",
   "value": 22.0,
   "location": "host_domain",
   "_comment": "PAPER_VALUE Tab. 4: T0 = 22 degC (isotropic COx). DEGREES CELSIUS."
  }
 ],
 "boundary_conditions": [
  {
   "type": "neumann",
   "field": "temperature",
   "value": 25.46,
   "location": "gallery_wall",
   "start_time": 15865200.0,
   "_comment": "PAPER_VALUE Tab. 3: constant power 200 W/m per gallery metre from T0+6 months for 10 y. Flux density = 200/((pi/2)*1.25) = 101.86 W/m2 over the quarter-circle wall. start_time = 86400 + 182.625 d = 1.5886e7 s."
  },
  {
   "type": "dirichlet",
   "field": "temperature",
   "value": 22.0,
   "location": "far_right"
  },
  {
   "type": "dirichlet",
   "field": "temperature",
   "value": 22.0,
   "location": "far_top",
   "_comment": "ASSUMED: outer thermal BC not explicitly stated in extracted text. Impact LOW: 10-y thermal diffusion length sqrt(kappa*t) = sqrt(6.69e-7*3.16e8) ~ 14.5 m << 100 m, so the boundary is never reached. Symmetry edges carry NO BC (zero flux)."
  }
 ],
 "assignment": {
  "domains": {
   "host_domain": {
    "active_fields": [
     "temperature"
    ],
    "material": "cox"
   }
  }
 },
 "time_stepping": {
  "t_start": 0.0,
  "t_end": 331441200.0,
  "analysis_type": "transient",
  "dt_strategy": {
   "type": "piecewise",
