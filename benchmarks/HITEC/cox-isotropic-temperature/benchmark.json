      "type": "log",
      "dt_min": 21600.0,
      "dt_max": 2592000.0,
      "n_steps": 30
     },
     "_comment": "waiting phase, no load. dt range 0.19-29.3 d, series sums exactly to span."
    },
    {
     "t_end": 16470000.0,
     "strategy": {
      "type": "log",
      "dt_min": 1800.0,
      "dt_max": 21600.0,
      "n_steps": 40
     },
     "_comment": "first 7 d of heating, finest. Unchanged - already consistent."
    },
    {
     "t_end": 47422800.0,
     "strategy": {
      "type": "log",
      "dt_min": 86400.0,
      "dt_max": 432000.0,
      "n_steps": 120
     },
     "_comment": "rest of heating year 1. dt grows 1.69 d -> 4.82 d; 120 log steps cover the 358.2 d span exactly (dt/t ~ 0.9% per step)."
    },
    {
     "t_end": 331441200.0,
     "strategy": {
      "type": "log",
      "dt_min": 432000.0,
      "dt_max": 5184000.0,
      "n_steps": 160
     },
     "_comment": "years 1-10. dt grows 6.7 d -> 46.3 d; 160 log steps cover the 3287 d span exactly (dt/t ~ 1.2%)."
    }
   ]
  },
  "linear_solver": "dss",
  "_comment_linear_solver": "Skyline costs 107 s/step on this 11857-node gmsh mesh (bandwidth-bound) -> ~11 h for 362 steps; DSS reorders internally: 0.8 s/step, identical results. Safe here -- the caveat is free/unloaded mechanics, this is pure conduction with Dirichlet far-field."
 },
