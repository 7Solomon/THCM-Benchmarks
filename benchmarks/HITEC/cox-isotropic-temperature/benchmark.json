  "mesh": {
   "element_size": 2.0,
   "refinement": [
    {
     "around": "gallery_wall",
     "element_size": 0.15,
     "distance_min": 5.5,
     "transition": 25.0,
     "_comment": "0.15 m held out to 5.5 m from the wall so all four probes (r = 1.25..6.25 m) sit in the fine zone, grading to 2 m by 25 m. Thermal diffusion length sqrt(k/(rho*cp)*t_end) = 14.9 m, so nothing beyond ~25 m changes. No recombine here -> pure triangles -> the mixed-element trap does not apply."
    }
   ],
   "_comment": "element_size is the FAR-FIELD size; the near field comes from refinement."
  }
 },
