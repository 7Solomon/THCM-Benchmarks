                "coordinates": [
                    0.25,
                    0.4,
                    1.3
                ],
                "_comment": "RG8_CONCRACK: Displacement measurement point C on beam axis. C and D are 2.5m apart symmetric about mid-span (z=2.55m). Source: benchmark description Section 7.3.4.3."
            },
            {
                "name": "point_D",
                "coordinates": [
                    0.25,
                    0.4,
                    3.8
                ],
                "_comment": "RG8_CONCRACK: Displacement measurement point D on beam axis. C and D are 2.5m apart symmetric about mid-span (z=2.55m). Source: benchmark description Section 7.3.4.3."
            },
            {
                "name": "gage_core",
                "coordinates": [
                    0.25,
