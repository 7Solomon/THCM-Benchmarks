{
    "metadata": {
        "id": "concrack-restrained-beam",
        "title": "ConCrack's Restrained Beam",
        "source": {
            "authors": [
                "Pesavento, F.",
                "Knoppik, A.",
                "\u0160milauer, V.",
                "Briffaut, M.",
                "Rossi, P."
            ],
            "year": 2019,
            "journal": "RILEM State-of-the-Art Reports 27"
        },
        "dimension": 3,
        "physics_class": "hydro-thermo-mechanical",
        "validation_target": "Coupled hydro-thermo-mechanical behavior of a restrained beam",
        "notes": "RISKY: Multi-physics with >2 coupled fields. Data for geometry and BCs missing from provided text; placeholders used. OOFEM variant (2026-07-16): degC convention (D2); drying_shrinkage via mps MPS_humidity with REQUIRED mus (D11, includes MPS drying creep under load); humidity clamp expressed as a gated moisture film (dirichlet start_time is gated); Winkler end restraint -> per-node nodalspring elements. NOT honored on oofem: temperature k_alpha_reduction (constant conductivity), displacement alpha_0/a_E E-maturity (aging comes from the B3 solidification chain instead)."
    },
    "geometry": {
