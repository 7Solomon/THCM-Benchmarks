            {
                "id": "disp_cd_atena",
                "file": "reference/concrack_rg8_disp_cd_reference.csv",
                "has_header": true,
                "x_col": "time_days",
                "y_col": "disp_sim_ks025_mm",
                "label": "ATENA ks=0.25 (Jendele 2012, Fig. 6)"
            },
            {
                "id": "strain_core_thermal_ref",
                "file": "reference/concrack_rg8_strains_reference.csv",
                "has_header": true,
                "x_col": "time_days",
                "y_col": "core_thermal_ue",
                "label": "Core: Thermal strain (Jendele 2012, Fig. 7)"
            },
            {
                "id": "strain_core_total_ref",
                "file": "reference/concrack_rg8_strains_reference.csv",
                "has_header": true,
                "x_col": "time_days",
                "y_col": "core_total_ue",
                "label": "Core: Total strain (Jendele 2012, Fig. 7)"
            },
            {
                "id": "strain_surf_total_ref",
                "file": "reference/concrack_rg8_strains_reference.csv",
                "has_header": true,
                "x_col": "time_days",
                "y_col": "surf_total_ue",
                "label": "Surface: Total strain (Jendele 2012, Fig. 7)"
            }
        ],
        "queries": [
            {
                "id": "t",
                "type": "time",
                "display": false
            },
            {
                "id": "t_days",
                "type": "formula",
                "formula": "t * 1.157e-5",
                "depends_on": [
                    "t"
                ],
                "label": "Time [days]"
            },
            {
                "id": "uz_C",
                "type": "field",
                "field": "displacement",
                "component": "uz",
                "at": "point_C",
                "reduce": "value",
                "evaluate_in": "fem",
                "display": false
            },
            {
                "id": "uz_D",
                "type": "field",
                "field": "displacement",
                "component": "uz",
                "at": "point_D",
                "reduce": "value",
                "evaluate_in": "fem",
                "display": false
            },
            {
                "id": "disp_CD_m",
                "type": "formula",
                "formula": "uz_D - uz_C",
                "depends_on": [
                    "uz_C",
                    "uz_D"
                ],
                "_comment": "Relative displacement C-D [m] \u2014 primary validation target Fig. 7.10",
                "display": false
            },
            {
                "id": "disp_CD_mm",
                "type": "formula",
                "formula": "disp_CD_m * 1000.0",
                "depends_on": [
                    "disp_CD_m"
                ],
                "_comment": "Relative displacement C-D [mm] \u2014 for plotting vs. reference",
                "label": "Displ. C-D [mm]"
            },
            {
                "id": "temp_core_C",
                "type": "field",
                "field": "temperature",
                "component": "T",
                "at": "gage_core",
                "reduce": "value",
                "_comment": "Field already in degC (D2). Validate: peak should be 53.7 degC at ~30h (1.25 days)",
                "label": "Core temp [\u00b0C]"
            },
            {
                "id": "humidity_core",
                "type": "field",
                "field": "humidity",
                "component": "h",
                "at": "gage_core",
                "reduce": "value",
                "label": "Core humidity [-]"
            },
            {
                "id": "total_strain_core_ue",
                "type": "field",
                "field": "total_strain",
                "component": "ezz",
                "at": "gage_core",
                "reduce": "value",
                "evaluate_in": "fem",
                "_comment": "Longitudinal (z-axis) total strain at core [m/m] \u2014 multiply by 1e6 for \u03bc\u03b5",
                "display": false
            },
            {
                "id": "total_strain_core_ue_scaled",
                "type": "formula",
                "formula": "total_strain_core_ue * 1e6",
                "depends_on": [
                    "total_strain_core_ue"
                ],
                "label": "Core strain \u03b5zz [\u03bc\u03b5]"
            }
        ],
        "plots": [
            {
                "name": "displacement_cd",
                "title": "RG8: Relative Displacement C-D",
                "x_axis": {
                    "label": "Time [days]"
                },
                "y_axis": {
                    "label": "Displ. C-D [mm]"
                },
                "grid": true,
                "curves": [
                    {
                        "source": "simulation",
                        "x": {
                            "key": "t_days"
                        },
                        "y": {
                            "key": "disp_CD_mm"
                        },
                        "label": "FEM simulation"
                    },
                    {
                        "source": "reference",
                        "ref_id": "disp_cd_exp",
                        "label": "Experiment (Jendele 2012)"
                    },
                    {
                        "source": "reference",
                        "ref_id": "disp_cd_atena",
                        "label": "ATENA ks=0.25"
                    }
                ]
            },
            {
                "name": "temperature_core",
                "title": "RG8: Core Temperature",
                "x_axis": {
                    "label": "Time [days]"
                },
                "y_axis": {
                    "label": "Temperature [\u00b0C]"
                },
                "grid": true,
                "curves": [
                    {
                        "source": "simulation",
                        "x": {
                            "key": "t_days"
                        },
                        "y": {
                            "key": "temp_core_C"
                        },
                        "label": "FEM simulation"
                    }
                ]
            },
            {
                "name": "strain_core_total",
                "title": "RG8: Total Longitudinal Strain \u2014 Core",
                "x_axis": {
                    "label": "Time [days]"
                },
                "y_axis": {
                    "label": "Strain [\u03bc\u03b5]"
                },
                "grid": true,
                "curves": [
                    {
                        "source": "simulation",
                        "x": {
                            "key": "t_days"
                        },
                        "y": {
                            "key": "total_strain_core_ue_scaled"
                        },
                        "label": "FEM total strain (core)"
                    },
                    {
                        "source": "reference",
                        "ref_id": "strain_core_total_ref",
                        "label": "Reference total (core)"
                    }
                ]
            },
            {
                "name": "deviation_cd",
                "title": "RG8: Deviation from Experiment",
                "curves": [
                    {
                        "source": "simulation",
                        "x": {
                            "key": "t_days"
                        },
                        "y": {
                            "key": "dev_disp_CD_mm__disp_cd_exp"
                        },
                        "label": "FEM - Experiment [mm]"
                    }
                ]
            }
        ],
        "aux_fields": [
            "*"
        ],
        "console": {
            "summary_every_steps": 25,
            "reference_deviation": {
                "enabled": true,
                "show_in_progress_bar": true,
                "pairs": [
                    {
                        "x": "t_days",
                        "y": "disp_CD_mm",
                        "ref_id": "disp_cd_exp"
                    }
                ]
            }
        },
        "save_checkpoint": true,
        "export_vtu": true,
        "save_db": true
    }
}