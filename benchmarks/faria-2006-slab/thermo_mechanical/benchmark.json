  "materials": {
    "concrete": {
      "temperature": {
        "k": 2.6,
        "rho": 2400.0,
        "cp": 1000.0,
        "_comment_k": "PAPER_VALUE: Table 1, 2.6 W/mK",
        "_comment_rho_cp": "INFERRED: Table 1 qc=2400 J/m3K is a unit error \u2192 2400 kJ/m3K = rho*cp"
      },
      "degree_of_hydration": {
        "model": "affinity",
        "B1": 2.1314e-05,
        "B2": 1.0,
        "alpha_inf": 0.93,
        "eta": 2.9869,
        "Ea": 50000.0,
        "R": 8.314,
        "T_ref": 298.15,
        "Hu": 420.2,
        "c_cement": 285.0,
        "_comment_source": "CALIBRATED: taken verbatim from the sibling thermal benchmark (../thermal/benchmark.json), which fitted these against Fig. 7a/7b. Previously this file carried unfitted placeholders (B1=3.6e-4, B2=5.0e-4, alpha_inf=0.85, eta=6.0, Hu=450, T_ref=293.15) and its own notes flagged them MISSING/CALIBRATE -- with those the peak temperature, and therefore every stress in Fig. 9, was meaningless.",
        "_comment_T_ref": "PAPER-ADJACENT: 25 C = 298.15 K. KELVIN only (the BC/IC fields stay degC).",
        "_comment_Ea": "PAPER_VALUE: Table 1, 50 kJ/mol.",
        "_comment_c_cement": "PAPER_VALUE: 285 kg/m3 (Sec. 4.1).",
        "_comment_sanity": "dT_ad = Hu*c*alpha_inf/(rho*cp) = 420.2e3*285*0.93/(2400*1000) = 46.4 K. Fig. 5's pseudo-adiabatic curve rises 15 -> 61.4 C = 46.4 K. Exact match -- this is what fig5_pseudo_adiabatic.csv is for."
      },
      "displacement": {
        "model": "linear_elastic",
        "E": 29000000000.0,
        "nu": 0.2,
        "plane_stress": false,
        "alpha_0": 0.0,
        "alpha_inf": 1.0,
        "a_E": 0.5,
        "E_min": 100000000.0,
        "_comment_E_nu": "PAPER_VALUE: Table 2 Ec=29e9*a^0.5 Pa, nu=0.2. a_E=0.5, alpha_0=0 match Table 2. On OOFEM those ageing keys are SILENTLY IGNORED \u2014 stiffness stays 29 GPa from t=0. RISKY for early compression.",
        "_comment_plane": "Default plane strain + ux=0 on both sides = \u03b5x=\u03b5z=0 = infinite slab (Fig. 9). Do NOT set plane_stress."
      },
      "thermal_strain": {
        "alpha_T": 1e-05,
        "T_strain_free_ref": 20.0,
        "_comment": "PAPER_VALUE: Table 2 aT=10e-6 /K. T_strain_free_ref ASSUMED 20 C (Fig. 18 T(0)=20). DEGREES CELSIUS. Free strain aT*13 K = 130 \u00b5\u03b5 \u2014 same order as Fig. 18 (~80 \u00b5\u03b5 after they zero at cooling start)."
      },
      "power_law_creep": {
        "E28": 29000000000.0,
        "phi_inf": 2.26,
        "fi1": 2.26,
        "m": 0.35,
        "n": 0.3,
        "alpha": 0.0,
        "t1": 1.0,
        "age_at_start_days": 0.01,
        "_comment": "PAPER_VALUE: Table 2 DPL phi1=2.26, m=0.35, n=0.3. E0 taken as Ec1=29 GPa. Extra keys (fi1, m, alpha) are what oofem doublepowerlaw actually reads \u2014 keep both spellings until the builder is documented. age_at_start_days ASSUMED 0.01 d so t0^{-m} is finite. Time unit of DPL in oofem is DAYS."
      }
    }
  },
